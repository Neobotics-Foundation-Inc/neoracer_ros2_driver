.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# colcon
COLCON_IGNORE
.colcon-defaults.yaml

# rosdep
.rosdep_install_marker

# OS / temp
*.log
*.tmp
*.bak
*.orig

# Jupyter
.ipynb_checkpoints/

# Local-only configuration overrides
neoracer_ros2_driver/config/*.local.yaml

# Model artifacts. .pt weights and the .engine are committed so a fresh clone
# runs inference at full speed without a what is close to eight-minute build.
# The engine is valid only for this fleet's exact configuration: SM 8.7 (Orin),
# TensorRT 10.3.0.30, JetPack L4T R36.4.3. A car that drifts from any of those
# cannot deserialize it and falls back to the .pt; see models/README.md.
# The ONNX is only an export intermediate, so it stays out.
models/*.onnx
