# ROS2 build artifacts
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# colcon
COLCON_IGNORE
.colcon-defaults.yaml

# rosdep
.rosdep_install_marker

# OS / temp
*.log
*.tmp
*.bak
*.orig

# Jupyter
.ipynb_checkpoints/

# Local-only configuration overrides
config/*.local.yaml

# Lab dashboards ship in scripts/dashboards/<id>/ and are tracked here. A car
# set up before they moved in-tree has a checkout of each one's old repository
# at scripts/dashboards/<repo>_dashboard/. setup_dashboards.sh copies a
# checkout's tuning, logs and data out, then moves it to .migrated/.
scripts/dashboards/*_dashboard/
scripts/dashboards/.migrated/
# Per-car dashboard tuning saved beside a dashboard (racecar profile migrate
# moves it into the car profile)
scripts/dashboards/*/*.local.yaml

# Model artifacts. .pt weights and the .engine are committed so a fresh clone
# runs inference at full speed without a what is close to eight-minute build.
# The engine is valid only for this fleet's exact configuration: SM 8.7 (Orin),
# TensorRT 10.3.0.30, JetPack L4T R36.4.3. A car that drifts from any of those
# cannot deserialize it and falls back to the .pt; see models/README.md.
# The ONNX is only an export intermediate, so it stays out.
models/*.onnx
