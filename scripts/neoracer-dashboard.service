[Unit]
Description=Neoracer Web Dashboard (port 8080)
Wants=neoracer-data.service
After=neoracer-data.service
After=neoracer-teleop.service

[Service]
Type=exec
User=racecar
Group=racecar
EnvironmentFile=-/run/racecar/environment
ExecStart=/bin/bash -c '\
    source /opt/ros/humble/setup.bash && \
    source /home/racecar/ros2_ws/install/setup.bash && \
    exec python3 /home/racecar/ros2_ws/src/neoracer_ros2_driver/scripts/dashboard.py'
Restart=on-failure
RestartSec=5
Environment=HOME=/home/racecar
WorkingDirectory=/home/racecar/ros2_ws

[Install]
WantedBy=multi-user.target
