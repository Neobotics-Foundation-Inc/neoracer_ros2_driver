[Unit]
Description=Neoracer JupyterLab (port 8888)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=racecar
Group=racecar
ExecStart=/bin/bash -c '\
    source /opt/ros/humble/setup.bash && \
    source /home/racecar/ros2_ws/install/setup.bash && \
    LOG_DIR="$(readlink -f /home/racecar/logs/latest 2>/dev/null || echo /home/racecar/logs)"; \
    mkdir -p "$LOG_DIR"; \
    exec /home/racecar/.local/bin/jupyter lab \
        --ip=0.0.0.0 \
        --port=8888 \
        --no-browser \
        --notebook-dir=/home/racecar/jupyter_ws \
        --ServerApp.token="" \
        --ServerApp.password="" \
        2>&1 | tee -a "$LOG_DIR/jupyter.log"'
Restart=on-failure
RestartSec=5
# The ROS environment comes from setup.bash, as in the dashboard and watchdog
# units. Hardcoding it missed /opt/ros/humble/local/lib/python3.10/dist-packages,
# where rclpy actually lives, so notebooks could not import it.
Environment=HOME=/home/racecar
WorkingDirectory=/home/racecar/jupyter_ws

[Install]
WantedBy=multi-user.target
